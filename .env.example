# TestImpact AI - Environment Configuration Template
# Copy this file to .env and populate with appropriate values.

# Database
DATABASE_URL=sqlite:///./testimpact.db

# Company Embedding API (Fill when credentials & endpoint are approved)
COMPANY_EMBEDDING_API_URL=
COMPANY_EMBEDDING_API_KEY=
COMPANY_EMBEDDING_MODEL=

# ChromaDB Settings
RAG_CHROMA_DIR=./chroma_db
RAG_COLLECTION_NAME=testimpact_company_v1
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=100

